  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://worked.dev/mcp",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "Your Worked API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
